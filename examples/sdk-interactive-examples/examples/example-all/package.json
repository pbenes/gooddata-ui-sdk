{
  "name": "@gooddata/sdk-interactive-example-all",
  "version": "11.19.0-alpha.8",
  "private": false,
  "description": "Container that lets you switch between all interactive examples using a simple left-menu router.",
  "license": "LicenseRef-LICENSE",
  "author": "GoodData",
  "type": "module",
  "scripts": {
    "_phase:build": "npm run build",
    "_phase:validate": "npm run validate",
    "build": "npm-run-all -p build-check build-ts",
    "build-check": "tsgo",
    "build-ts": "tsgo -p tsconfig.build.json",
    "build-example": "vite build",
    "clean": "rm -rf esm dist *.log",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "oxfmt-check": "oxfmt --check .",
    "oxfmt-write": "oxfmt .",
    "preview": "vite preview",
    "refresh-md": "gdc-catalog-export && npm run oxfmt-write",
    "start": "vite serve",
    "update-version": "node ./scripts/updateWorkspaceVersion.mjs && node ./scripts/updateViteVersion.mjs",
    "validate": "npm run eslint && npm run oxfmt-check"
  },
  "dependencies": {
    "@gooddata/sdk-backend-base": "11.19.0-alpha.8",
    "@gooddata/sdk-backend-spi": "11.19.0-alpha.8",
    "@gooddata/sdk-backend-tiger": "11.19.0-alpha.8",
    "@gooddata/sdk-model": "11.19.0-alpha.8",
    "@gooddata/sdk-ui": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-charts": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-dashboard": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-ext": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-filters": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-geo": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-kit": "11.19.0-alpha.8",
    "@gooddata/sdk-ui-pivot": "11.19.0-alpha.8",
    "default-import": "1.1.5",
    "highcharts": "12.2.0",
    "highcharts-react-official": "3.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@gooddata/catalog-export": "11.19.0-alpha.8",
    "@gooddata/eslint-config": "11.19.0-alpha.8",
    "@types/node": "^22.13.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@typescript/native-preview": "7.0.0-dev.20260202.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-headers": "1.3.3",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-import-esm": "1.2.1",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-jsdoc": "62.1.0",
    "eslint-plugin-no-barrel-files": "1.2.2",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-sonarjs": "3.0.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.27.0",
    "prettier": "^3.6.2",
    "process": "^0.11.10",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-html": "~3.2.0"
  },
  "gooddata": {
    "hostname": "https://public-examples.gooddata.com",
    "workspaceId": "demo_ecommerce",
    "backend": "tiger",
    "catalogOutput": "src/catalog.ts"
  },
  "title": "All Interactive Examples"
}